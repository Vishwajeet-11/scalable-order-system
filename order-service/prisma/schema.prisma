generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int
  status    String   @default("created")
  createdAt DateTime @default(now())
}
