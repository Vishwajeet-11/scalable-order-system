generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Payment {
  id        String   @id @default(uuid())
  orderId   String
  userId    String
  amount    Int
  status    String   @default("pending")
  createdAt DateTime @default(now())
}



